# Neon Postgres connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Seed admin account (used by `pnpm db:seed`)
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-please"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Gmail SMTP (transactional email — verification, password reset, notifications)
# GMAIL_APP_PASSWORD is generated at myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the account).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Upstash Redis (rate limiting on booking/payment mutations). Optional --
# rate limiting is skipped with a console warning if unset. Create a free
# database at console.upstash.com and copy the REST credentials from its
# dashboard.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
